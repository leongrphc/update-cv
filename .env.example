# AI API (en az biri gerekli)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Database
DATABASE_URL="file:./dev.db"

# Auth (rastgele, en az 32 baytlık bir değer kullanın)
JWT_SECRET=

# İş arama ve zamanlanmış bildirim kontrolü
APIFY_API_TOKEN=
CRON_SECRET=

# Üretimde şifre sıfırlama e-postası (587: STARTTLS, 465: TLS)
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
