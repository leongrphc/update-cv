{
  "name": "cv-optimizer",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "dev": "next dev",
    "setup": "node scripts/setup-local.mjs && npm run db:setup",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "db:push": "prisma db push",
    "db:setup": "prisma migrate deploy && prisma generate",
    "test:migrations": "node scripts/check-migrations.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:editor": "node scripts/test-editor.mjs",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/sanitize-cloudflare-env.mjs",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "db:cloudflare:check": "node scripts/migrate-cloudflare.mjs --remote",
    "db:cloudflare:migrate": "node scripts/migrate-cloudflare.mjs --remote --apply"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.130",
    "@ai-sdk/openai": "^3.0.124",
    "@opennextjs/cloudflare": "1.20.8",
    "@prisma/adapter-d1": "5.18.0",
    "@prisma/client": "^5.18.0",
    "@react-pdf/renderer": "^4.9.0",
    "@thednp/dommatrix": "3.1.2",
    "ai": "^6.0.301",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.6.3",
    "lucide-react": "^0.427.0",
    "next": "^15.5.27",
    "nodemailer": "^10.0.15",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^14.2.3",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "postcss": "$postcss",
    "picomatch@<=2.3.1": "^2.3.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.14",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.27",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^4.1.5",
    "wrangler": "4.147.0"
  }
}
